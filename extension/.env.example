# Backend API base URL including /api/v1 (no trailing slash required)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional shared API key. Must match backend LEXICARD_API_KEY when that is set.
# Note: values baked into a published Chrome extension can be extracted.
# Prefer self-hosting + rate limits for production protection.
# VITE_LEXICARD_API_KEY=

# Client-side request timeout in milliseconds
VITE_API_TIMEOUT_MS=50000
