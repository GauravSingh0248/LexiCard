# Required: Groq API key (never commit real values)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model id
GROQ_MODEL=openai/gpt-oss-20b

# development | production
ENVIRONMENT=development

# Comma-separated browser origins allowed by CORS (Vite dev defaults apply if unset)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chrome extension origin regex. Set empty to disable regex matching.
# EXTENSION_ORIGIN_REGEX=chrome-extension://[a-p]{32}

# Optional shared API key. When set, clients must send header: X-API-Key: <value>
# Recommended for any publicly reachable backend.
# LEXICARD_API_KEY=generate_a_long_random_secret

# Rate limiting for POST /api/v1/flashcards/generate
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum JSON request body size in bytes
MAX_REQUEST_BYTES=4096

# Upstream LLM call timeout in seconds
LLM_TIMEOUT_SECONDS=45

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
